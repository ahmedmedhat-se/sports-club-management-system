<%- include('partials/header') %>
<%- include('partials/alerts') %>

<% if (action === 'list') { %>
    <div class="page-header">
        <h2>Reservations Management</h2>
        <a href="/reservations?action=create" class="btn btn-primary">Add New Reservation</a>
    </div>

    <div class="table-container">
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Member</th>
                    <th>Facility</th>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (reservations && reservations.length > 0) { %>
                    <% reservations.forEach(r => { %>
                        <tr>
                            <td><%= r.ReservationId %></td>
                            <td><%= r.MemberName %></td>
                            <td><%= r.FacilityName %></td>
                            <td><%= new Date(r.ReservationDate).toLocaleDateString() %></td>
                            <td><%= r.ReservationStartTime %> - <%= r.ReservationEndTime %></td>
                            <td><span class="badge badge-<%= r.ReservationStatus.toLowerCase() %>"><%= r.ReservationStatus %></span></td>
                            <td class="actions">
                                <a href="/reservations?action=edit&id=<%= r.ReservationId %>" class="btn btn-sm btn-warning">Edit</a>
                                <form action="/reservations/delete?_method=DELETE&id=<%= r.ReservationId %>" method="POST" style="display:inline;" onsubmit="return confirm('Delete this reservation?')">
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr><td colspan="7" class="text-center">No reservations found</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>

<% } else if (action === 'create') { %>
    <div class="form-container">
        <div class="form-card">
            <div class="form-header">
                <h2>Add New Reservation</h2>
                <a href="/reservations" class="btn btn-secondary">Back</a>
            </div>
            <form action="/reservations" method="POST" id="reservationForm">
                <div class="form-row">
                    <div class="form-group">
                        <label for="MemberId">Member *</label>
                        <select id="MemberId" name="MemberId" required class="form-control">
                            <option value="">Select Member</option>
                            <% if (members) { %>
                                <% members.forEach(m => { %>
                                    <option value="<%= m.MemberId %>"><%= m.MemberFirstName %> <%= m.MemberLastName %></option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="FacilityId">Facility *</label>
                        <select id="FacilityId" name="FacilityId" required class="form-control">
                            <option value="">Select Facility</option>
                            <% if (facilities) { %>
                                <% facilities.forEach(f => { %>
                                    <option value="<%= f.FacilityId %>"><%= f.FacilityName %></option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label for="ReservationDate">Date *</label>
                    <input type="date" id="ReservationDate" name="ReservationDate" required class="form-control" value="<%= new Date().toISOString().split('T')[0] %>">
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="ReservationStartTime">Start Time *</label>
                        <input type="time" id="ReservationStartTime" name="ReservationStartTime" required class="form-control" value="09:00">
                    </div>
                    <div class="form-group">
                        <label for="ReservationEndTime">End Time *</label>
                        <input type="time" id="ReservationEndTime" name="ReservationEndTime" required class="form-control" value="10:00">
                    </div>
                </div>
                <div class="form-group">
                    <label for="ReservationStatus">Status</label>
                    <select id="ReservationStatus" name="ReservationStatus" class="form-control">
                        <option value="Confirmed">Confirmed</option>
                        <option value="Pending">Pending</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>
                <div class="form-actions">
                    <a href="/reservations" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Save Reservation</button>
                </div>
            </form>
        </div>
    </div>

<% } else if (action === 'edit') { %>
    <div class="form-container">
        <div class="form-card">
            <div class="form-header">
                <h2>Edit Reservation #<%= reservation.ReservationId %></h2>
                <a href="/reservations" class="btn btn-secondary">Back</a>
            </div>
            <form action="/reservations/update?_method=PUT&id=<%= reservation.ReservationId %>" method="POST" id="reservationForm">
                <div class="form-row">
                    <div class="form-group">
                        <label for="MemberId">Member *</label>
                        <select id="MemberId" name="MemberId" required class="form-control">
                            <option value="">Select Member</option>
                            <% members.forEach(m => { %>
                                <option value="<%= m.MemberId %>" <%= reservation.MemberId === m.MemberId ? 'selected' : '' %>><%= m.MemberFirstName %> <%= m.MemberLastName %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="FacilityId">Facility *</label>
                        <select id="FacilityId" name="FacilityId" required class="form-control">
                            <option value="">Select Facility</option>
                            <% facilities.forEach(f => { %>
                                <option value="<%= f.FacilityId %>" <%= reservation.FacilityId === f.FacilityId ? 'selected' : '' %>><%= f.FacilityName %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label for="ReservationDate">Date *</label>
                    <input type="date" id="ReservationDate" name="ReservationDate" value="<%= new Date(reservation.ReservationDate).toISOString().split('T')[0] %>" required class="form-control">
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="ReservationStartTime">Start Time *</label>
                        <input type="time" id="ReservationStartTime" name="ReservationStartTime" value="<%= reservation.ReservationStartTime %>" required class="form-control">
                    </div>
                    <div class="form-group">
                        <label for="ReservationEndTime">End Time *</label>
                        <input type="time" id="ReservationEndTime" name="ReservationEndTime" value="<%= reservation.ReservationEndTime %>" required class="form-control">
                    </div>
                </div>
                <div class="form-group">
                    <label for="ReservationStatus">Status</label>
                    <select id="ReservationStatus" name="ReservationStatus" class="form-control">
                        <option value="Confirmed" <%= reservation.ReservationStatus === 'Confirmed' ? 'selected' : '' %>>Confirmed</option>
                        <option value="Pending" <%= reservation.ReservationStatus === 'Pending' ? 'selected' : '' %>>Pending</option>
                        <option value="Cancelled" <%= reservation.ReservationStatus === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
                    </select>
                </div>
                <div class="form-actions">
                    <a href="/reservations" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Update Reservation</button>
                </div>
            </form>
        </div>
    </div>
<% } %>

<script>
document.getElementById('reservationForm')?.addEventListener('submit', function(e) {
    const startTime = document.getElementById('ReservationStartTime').value;
    const endTime = document.getElementById('ReservationEndTime').value;
    
    if (startTime >= endTime) {
        e.preventDefault();
        alert('End time must be after start time');
    }
});
</script>

<%- include('partials/footer') %>