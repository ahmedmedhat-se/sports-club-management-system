<%- include('partials/header') %>
<%- include('partials/alerts') %>

<% if (action === 'list') { %>
    <div class="page-header">
        <h2>Facilities Management</h2>
        <a href="/facilities?action=create" class="btn btn-primary">Add New Facility</a>
    </div>

    <div class="table-container">
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Capacity</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (facilities && facilities.length > 0) { %>
                    <% facilities.forEach(facility => { %>
                        <tr>
                            <td><%= facility.FacilityId %></td>
                            <td><%= facility.FacilityName %></td>
                            <td><%= facility.FacilityTypeName || 'N/A' %></td>
                            <td><%= facility.FacilityCapacity || '-' %></td>
                            <td><span class="badge badge-<%= (facility.FacilityStatus || 'available').toLowerCase() %>"><%= facility.FacilityStatus || 'Available' %></span></td>
                            <td class="actions">
                                <a href="/facilities?action=edit&id=<%= facility.FacilityId %>" class="btn btn-sm btn-warning">Edit</a>
                                <form action="/facilities/delete?id=<%= facility.FacilityId %>" method="POST" style="display:inline;" onsubmit="return confirm('Delete this facility?')">
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr><td colspan="6" class="text-center">No facilities found</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>

<% } else if (action === 'create') { %>
    <div class="form-container">
        <div class="form-card">
            <div class="form-header">
                <h2>Add New Facility</h2>
                <a href="/facilities" class="btn btn-secondary">Back</a>
            </div>
            <form action="/facilities" method="POST" id="facilityForm">
                <div class="form-group">
                    <label for="FacilityName">Facility Name *</label>
                    <input type="text" id="FacilityName" name="FacilityName" required maxlength="100" class="form-control" placeholder="Enter facility name">
                </div>
                <div class="form-group">
                    <label for="FacilityLocation">Location</label>
                    <input type="text" id="FacilityLocation" name="FacilityLocation" maxlength="150" class="form-control" placeholder="Enter location">
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="FacilityTypeId">Facility Type</label>
                        <select id="FacilityTypeId" name="FacilityTypeId" class="form-control">
                            <option value="">Select Type</option>
                            <% if (facilityTypes) { %>
                                <% facilityTypes.forEach(type => { %>
                                    <option value="<%= type.FacilityTypeId %>"><%= type.FacilityTypeName %></option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="FacilityCapacity">Capacity</label>
                        <input type="number" id="FacilityCapacity" name="FacilityCapacity" min="1" max="10000" class="form-control" placeholder="100">
                    </div>
                </div>
                <div class="form-actions">
                    <a href="/facilities" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Save Facility</button>
                </div>
            </form>
        </div>
    </div>

<% } else if (action === 'edit') { %>
    <div class="form-container">
        <div class="form-card">
            <div class="form-header">
                <h2>Edit Facility #<%= facility.FacilityId %></h2>
                <a href="/facilities" class="btn btn-secondary">Back</a>
            </div>
            <form action="/facilities/update?id=<%= facility.FacilityId %>" method="POST" id="facilityForm">
                <div class="form-group">
                    <label for="FacilityName">Facility Name *</label>
                    <input type="text" id="FacilityName" name="FacilityName" value="<%= facility.FacilityName %>" required maxlength="100" class="form-control">
                </div>
                <div class="form-group">
                    <label for="FacilityLocation">Location</label>
                    <input type="text" id="FacilityLocation" name="FacilityLocation" value="<%= facility.FacilityLocation || '' %>" maxlength="150" class="form-control">
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="FacilityTypeId">Facility Type</label>
                        <select id="FacilityTypeId" name="FacilityTypeId" class="form-control">
                            <option value="">Select Type</option>
                            <% facilityTypes.forEach(type => { %>
                                <option value="<%= type.FacilityTypeId %>" <%= facility.FacilityTypeId == type.FacilityTypeId ? 'selected' : '' %>><%= type.FacilityTypeName %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="FacilityCapacity">Capacity</label>
                        <input type="number" id="FacilityCapacity" name="FacilityCapacity" value="<%= facility.FacilityCapacity || '' %>" min="1" max="10000" class="form-control">
                    </div>
                </div>
                <div class="form-group">
                    <label for="FacilityStatus">Status</label>
                    <select id="FacilityStatus" name="FacilityStatus" class="form-control">
                        <option value="Available" <%= facility.FacilityStatus === 'Available' ? 'selected' : '' %>>Available</option>
                        <option value="Under Maintenance" <%= facility.FacilityStatus === 'Under Maintenance' ? 'selected' : '' %>>Under Maintenance</option>
                        <option value="Closed" <%= facility.FacilityStatus === 'Closed' ? 'selected' : '' %>>Closed</option>
                    </select>
                </div>
                <div class="form-actions">
                    <a href="/facilities" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Update Facility</button>
                </div>
            </form>
        </div>
    </div>
<% } %>

<script>
document.getElementById('facilityForm')?.addEventListener('submit', function(e) {
    const name = document.getElementById('FacilityName').value.trim();
    if (!name) {
        e.preventDefault();
        alert('Facility name is required');
    }
});
</script>

<%- include('partials/footer') %>